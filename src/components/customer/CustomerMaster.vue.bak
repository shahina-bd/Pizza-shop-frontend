<template>
    <div>
        <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
            <div class="container">
                <router-link class="navbar-brand" to="/">
                    Ghorer Bazar 365
                </router-link>

                <div class="ms-auto d-flex align-items-center gap-2">
                    <router-link class="btn btn-outline-light btn-sm" to="/cart">
                        Cart
                        <span class="badge bg-warning text-dark">
                            {{ cartStore.totalItems }}
                        </span>
                    </router-link>

                    <template v-if="customerAuthStore.isAuthenticated">
                        <span class="text-white small">
                            {{ customerAuthStore.user?.name }}
                        </span>
                        <router-link class="btn btn-outline-light btn-sm" to="/customer/dashboard">
                            Customer Dashboard
                        </router-link>

                        <button class="btn btn-danger btn-sm" @click="logout">
                            Logout
                        </button>
                    </template>

                    <template v-else>
                        <router-link class="btn btn-light btn-sm" to="/customer/login">
                            Login
                        </router-link>
                    </template>
                </div>
            </div>
        </nav>

        <slot></slot>
    </div>
</template>

<script setup>
import { useRouter } from 'vue-router'
import { useCartStore } from '@/stores/cart'
import { useCustomerAuthStore } from '@/stores/customerAuth'

const router = useRouter()
const cartStore = useCartStore()
const customerAuthStore = useCustomerAuthStore()

const logout = async () => {
    await customerAuthStore.logout()
    router.push('/')
}
</script>